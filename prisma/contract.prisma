// use prisma-8
// Prisma Schema file


// AUTH REQUIRED MODELS

model User {
    id            String    @id @onCreate(cuid(2))
    name          String?
    email         String    @unique
    emailVerified DateTime?
    image         String?
    password      String?   // only used if they sign up with email/password
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @onCreate(now()) @onUpdate(now())

    // Relations
    accounts      Account[]
    sessions      Session[]
    automations   Automation[]
    subscription  Subscription?
}

model Account {
    id                String  @id @onCreate(cuid(2))
    userId            String
    type              String
    provider          String
    providerAccountId String
    refresh_token     String?
    access_token      String?
    expires_at        Int?
    token_type        String?
    scope             String?
    id_token          String?
    session_state     String?

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([provider, providerAccountId])
}

model Session {
    id           String   @id @onCreate(cuid(2))
    sessionToken String   @unique
    userId       String
    expires      DateTime

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
}

model Automation {
    id          String   @id @onCreate(cuid(2))
    userId      String
    name        String                        // e.g. "Reply to giveaway comments"
    platform    String                        // e.g. "twitter", "instagram"
    trigger     String                        // the keyword/phrase to watch for
    dmMessage   String                        // the DM to send when triggered
    isActive    Boolean  @default(true)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @onCreate(now()) @onUpdate(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
    id            String   @id @onCreate(cuid(2))
    userId        String   @unique             // one subscription per user
    plan          String   @default("free")    // "free" or "premium"
    walletAddress String?                      // crypto wallet if paid with crypto
    txHash        String?                      // blockchain transaction hash
    expiresAt     DateTime?                    // null = no expiry (lifetime deal)
    createdAt     DateTime @default(now())
    updatedAt     DateTime @onCreate(now()) @onUpdate(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
